APP_NAME="AurumDent CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Paris
APP_URL=https://crm.votre-domaine.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Base de données (MySQL dans docker-compose) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=change-moi

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

APP_PORT=8080

# --- Emails (envoi des emails IA aux prospects) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.votre-domaine.fr
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@votre-domaine.fr"
MAIL_FROM_NAME="${APP_NAME}"

# --- IA : Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
AI_AUTO_SCORE_IMPORTS=true
AI_AUTO_SUMMARIZE_CALLS=true
AI_JOBS_PER_MINUTE=40
# AI_COMPANY_CONTEXT="Présentation de votre société, injectée dans tous les prompts"

# --- Téléphonie : Ringover ---
RINGOVER_API_KEY=
RINGOVER_BASE_URL=https://public-api.ringover.com/v2
# Chaîne aléatoire longue : l'URL du webhook sera {APP_URL}/webhooks/ringover/{RINGOVER_WEBHOOK_TOKEN}
RINGOVER_WEBHOOK_TOKEN=
RINGOVER_SYNC_ENABLED=true
RINGOVER_SYNC_LOOKBACK=30

# --- Compte administrateur initial (php artisan db:seed --class=AdminSeeder) ---
ADMIN_NAME="Administrateur"
ADMIN_EMAIL=admin@votre-domaine.fr
ADMIN_PASSWORD=
DB_ROOT_PASSWORD=change-moi-aussi
